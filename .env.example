# =============================================================
# tradingview-mcp — Local Environment Configuration
# =============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below
# 3. .env is in .gitignore — it will NEVER be committed to git
# =============================================================

# ── News (Optional — Marketaux) ───────────────────────────────
# financial_news / news-driven sentiment use the licensed Marketaux API
# (replaced the old RSS/Reddit scraping). Get a token at
# https://www.marketaux.com — without it the news tools return empty
# results (every other tool works normally).

MARKETAUX_API_TOKEN=your_marketaux_token_here
# Max Marketaux requests per day before serving cached/stub results
MARKETAUX_DAILY_BUDGET=90

# ── Proxy (Optional — Webshare Rotating Residential) ──────────
# Get credentials from: https://proxy.webshare.io/proxy/list
# Enables access to Yahoo Finance and Xueqiu behind rate-limits.
# Leave blank to run WITHOUT proxy (TradingView tools work fine without it).

PROXY_HOST=p.webshare.io
PROXY_PORT=80
PROXY_USERNAME_PREFIX=your_username_prefix   # e.g. hvfvdamo
PROXY_PASSWORD=your_password_here
PROXY_SESSION_MIN=1
PROXY_SESSION_MAX=250

# Set to false to disable proxy entirely
PROXY_ENABLED=true

# =============================================================
# Trading system extension (Block 1+) — Bybit collector, paper
# trading, and the future Strategy/Risk engines.
#
# This is entirely separate from the TradingView MCP tools above:
# nothing here is required for `tradingview-mcp` itself to run.
# It only applies to the `bybit-collector` / `analysis-worker` /
# `paper-broker` Docker Compose services.
#
# TRADING_MODE must stay "paper" — there is no live-trading code
# path in this project, and the config loader refuses to start
# with any other value.
# =============================================================

TRADING_MODE=paper

BYBIT_TESTNET=false
BYBIT_MARKET=linear
TRADING_SYMBOLS=BTCUSDT

# Use the `postgres` / `redis` service names when running under Docker
# Compose; use localhost when running a worker directly on your machine.
DATABASE_URL=postgresql+asyncpg://trading:change_me@postgres:5432/trading
REDIS_URL=redis://redis:6379/0

COLLECT_TRADES=true
COLLECT_ORDERBOOK=true
ORDERBOOK_DEPTH=50
COLLECT_LIQUIDATIONS=true
COLLECT_TICKERS=true
COLLECT_KLINES=true

FEATURE_INTERVAL_SECONDS=60
STRATEGY_INTERVAL_SECONDS=300
OI_POLL_INTERVAL_SECONDS=300
FUNDING_POLL_INTERVAL_SECONDS=300
ORDERBOOK_SNAPSHOT_INTERVAL_SECONDS=5

# Checked against the latest 1-minute trade_aggregates bucket's
# bucket_start, which is always up to ~60s old by construction — must
# stay >= ~90-120s or is_tradeable gets permanently stuck at False.
MAX_DATA_AGE_TRADES_SECONDS=120
MAX_DATA_AGE_ORDERBOOK_SECONDS=5
MAX_DATA_AGE_OI_SECONDS=600
# Checked against the latest *closed* 15m candle's open_time, which is
# always 15-30 min old by construction — must stay >= ~1200s or
# is_tradeable/regime classification gets permanently stuck at NO_DATA.
MAX_DATA_AGE_CANDLES_SECONDS=1200

# ── Paper trading risk params (enforced starting Block 2) ─────
PAPER_STARTING_BALANCE=10000
RISK_PER_TRADE_PCT=0.25
MAX_DAILY_LOSS_PCT=1.00
MAX_OPEN_POSITIONS=1
MAX_TRADES_PER_DAY=5
MAX_CONSECUTIVE_LOSSES=3
MIN_RISK_REWARD=2.0
MAX_LEVERAGE=3

# ── Signal params (used starting Block 2) ──────────────────────
SIGNAL_MIN_SCORE=75
SIGNAL_COOLDOWN_MINUTES=45
SIGNAL_EXPIRY_MINUTES=60

ENABLE_LIQUIDATION_REVERSAL=false

# ── Optional raw data archival (off by default) ────────────────
RAW_DATA_ARCHIVE_ENABLED=false
RAW_DATA_ARCHIVE_PATH=/data/archive

# ── Telegram alerts (used starting Block 3) ────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── bybit-collector's own health/metrics HTTP port ─────────────
TRADING_METRICS_PORT=9100

# ── Strategy/Scoring Engine config (Block 2) ────────────────────
# Path to the versioned weights/thresholds file. The default resolution
# already finds this inside the Docker image (WORKDIR /app); override only
# if you relocate the file.
STRATEGY_CONFIG_PATH=/app/config/strategies/v1.yaml
